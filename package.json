{
  "name": "pycoil",
  "private": true,
  "version": "0.1.0",
  "description": "PyCoil — Python per ingegneri, una spira al giorno. PWA per imparare Python in 10 minuti al giorno.",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check:content": "node scripts/build-content.mjs --check",
    "verify:content": "python3 scripts/verify_content.py && python3 scripts/check_order.py"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "^18.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
