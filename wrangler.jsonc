// PyCoil su Cloudflare Workers: l'app statica (cartella dist di `npm run build`) + /api per il promemoria giornaliero.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pycoil",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // indirizzo pubblico pycoil.<account>.workers.dev; niente indirizzi di anteprima per ogni versione
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROMEMORIA", "class_name": "Promemoria" },
      // account facoltativi con passkey e progressi sincronizzati (worker/conto.js)
      { "name": "CONTO", "class_name": "Conto" },
      { "name": "SFIDE", "class_name": "Sfide" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Promemoria"] },
    { "tag": "v2", "new_sqlite_classes": ["Conto", "Sfide"] }
  ],
  "observability": { "enabled": true }
}
